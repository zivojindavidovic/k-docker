# Lokalna konfiguracija k-docker okruzenja; .env nije u Git-u.
# Nije shell skripta, ne koristiti source.

# Putanja do k-fakture projekta, relativno na k-docker. Bez ovog reda koristi se
# ../k-fakture (ime iz scripts/helpers/projects.list).
K_FAKTURE_PATH=../k-fakture

# FastCGI port k-fakture PHP-FPM kontejnera, preko njega k-local izvrsava PHP.
# Bez ovog reda koristi se 9082. Pri promeni izmeniti i fastcgi_pass u
# containers/k-local/conf.d/k-fakture.conf.
K_FAKTURE_PORT=9082

# k-auth (auth servis): putanja projekta (bez ovog reda ../kancelarko) i
# FastCGI port (bez ovog reda 9083). Pri promeni porta izmeniti i fastcgi_pass
# u containers/k-local/conf.d/k-auth.conf.
K_AUTH_PATH=../kancelarko
K_AUTH_PORT=9083

# k-invoice-db: PostgreSQL za fakture. Mora odgovarati DB_* u .env k-fakture
# projekta (DB_HOST=k-invoice-db). Unutar Docker mreze port je uvek 5432.
# POSTGRES_DB se pravi samo pri prvom startu praznog volumena; ostale baze se
# prave rucno u istoj instanci.
K_INVOICE_DB_PORT=5432
K_INVOICE_DB_DATABASE=invoice
K_INVOICE_DB_USERNAME=root
K_INVOICE_DB_PASSWORD=

# k-master-db: MariaDB sa office_master (root bez lozinke). Lokalni port;
# unutar Docker mreze uvek 3306 (DB_HOST=k-master-db).
K_MASTER_DB_PORT=3306

# k-license-1-db i k-license-2-db: MariaDB serveri tenant (licence) baza, root
# bez lozinke. Lokalni portovi; unutar Docker mreze uvek 3306. U office_license
# je DBHost = ime servisa (k-license-1-db / k-license-2-db).
K_LICENSE_1_DB_PORT=3308
K_LICENSE_2_DB_PORT=3309

# Redis: lokalni port; unutar Docker mreze uvek 6379 (REDIS_HOST=k-redis).
K_REDIS_PORT=6379

# Direktorijum sa SQL dump-ovima za `task db-seed` (office-master-init.sql i
# office-licence-init-*.sql). Dump-ovi nisu u k-docker repou.
K_DB_DUMPS_PATH=../rokovnik/docker/db

# k-gateway: putanja projekta (bez ovog reda ../k-gateway) i lokalni HTTP port
# (bez ovog reda 9090). Pri promeni porta izmeniti i proxy_pass u
# containers/k-local/conf.d/k-gateway.conf.
K_GATEWAY_PATH=../k-gateway
K_GATEWAY_PORT=9090
